{
  // The published build: ESM and type declarations in dist/, from the sources the site uses as
  // they are. Tests and the site's internals stay out.
  "compilerOptions": {
    "target": "ES2022",
    // The DOM's types: stickers are drawn in the page. Importing it touches no DOM, so a server can render the React one.
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/internal.ts"]
}
